# Generate auth token like this:
# echo -n "you@example.com:yourpassword" | base64
# Then prefix it with "Basic " in this file.

# OpenObserve connection
OPENOBSERVE_URL=https://api.openobserve.ai/
OPENOBSERVE_ORG=your_org_slug
OPENOBSERVE_AUTH_TOKEN=Basic <base64 of email:password>

# Anthropic for LLM (embeddings use local fastembed/ONNX, no key needed)
ANTHROPIC_API_KEY=sk-ant-...

# Service names for trace filtering in OpenObserve
LANGCHAIN_SERVICE_NAME=langchain-rag-demo
LLAMAINDEX_SERVICE_NAME=llamaindex-rag-demo
LANGGRAPH_SERVICE_NAME=langgraph-agent-demo

# Which backend the frontend talks to
BACKEND_URL=http://localhost:8001

# Set to true to also print spans to stdout for local debugging
DEBUG=false
